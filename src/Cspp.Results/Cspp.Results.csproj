<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Cspp.Results</PackageId>
    <!-- Local packs only. The release workflow sets the version from the v* tag. -->
    <Version>0.0.0</Version>
    <Authors>Tal Israeli</Authors>
    <Description>A Result type for returning success or failure without throwing exceptions, built on C# union types.</Description>
    <PackageTags>result;union;error-handling;functional</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/talisraeli/csharp-plus-plus</PackageProjectUrl>
    <RepositoryUrl>https://github.com/talisraeli/csharp-plus-plus.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Ship the analyzer inside this package so consumers get CSPP0001 without a separate reference. -->
  <ItemGroup>
    <ProjectReference Include="..\Cspp.Results.Analyzers\Cspp.Results.Analyzers.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <None Include="..\Cspp.Results.Analyzers\bin\$(Configuration)\netstandard2.0\Cspp.Results.Analyzers.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

</Project>
